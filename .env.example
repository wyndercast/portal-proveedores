# Variables locales del backend. No incluir secretos reales.
SPRING_PROFILES_ACTIVE=local
PORT=8080

# Reservadas para SPEC-000; no son necesarias para arrancar el bootstrap.
VALUEKEEP_BASE_URL=
VALUEKEEP_TOKEN_URL=https://identity.primaverabss.com/connect/token
VALUEKEEP_CLIENT_ID=
VALUEKEEP_CLIENT_SECRET=
VALUEKEEP_TENANT_KEY=
VALUEKEEP_ORG_KEY=
VALUEKEEP_COMPANY_KEY=
VALUEKEEP_UPLOAD_BASE_URL=https://cloud.valuekeep.com/app
VALUEKEEP_ACCESS_ALLOWED_STATES=OT03,OT04
VALUEKEEP_ALLOWED_SOURCE_STATES=
VALUEKEEP_CLOSING_STATE_KEY=
VALUEKEEP_OT_CLOSURE_ENABLED=false
VALUEKEEP_CLOSE_DOWNTIME=false
VALUEKEEP_APPLY_DOWNTIME_TO_CHILDREN=false
VALUEKEEP_EMPLOYEE_KEY=
VALUEKEEP_RATE_LIMIT=30
VALUEKEEP_RATE_LIMIT_WAIT_SECONDS=60
VALUEKEEP_CONNECT_TIMEOUT=5s
VALUEKEEP_READ_TIMEOUT=30s

# Acceso temporal de proveedores
PROVIDER_ACCESS_INACTIVITY_TIMEOUT_SECONDS=1800
PROVIDER_ACCESS_MAX_ATTEMPTS_PER_IP=10
PROVIDER_ACCESS_MAX_ATTEMPTS_PER_OT=5
PROVIDER_ACCESS_RATE_WINDOW_SECONDS=300
PROVIDER_ACCESS_MAX_SESSIONS=10000
PORTAL_FRONTEND_ORIGINS=http://localhost:4200,http://192.168.1.4:4200,http://172.17.0.1:4200
# Optional override for local mobile testing through ngrok. Restart the backend after changes.
# PORTAL_FRONTEND_ORIGIN_PATTERNS=https://*.ngrok-free.app,https://*.ngrok-free.dev,https://*.ngrok.app,https://*.ngrok.io
